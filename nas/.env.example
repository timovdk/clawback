# Cloudflare R2: account id (dashboard → R2 → right-hand side) and an API token with
# "Object Read & Write" for this bucket only (R2 → Manage API tokens).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=clawback
# Tell OVapi who downloads their feed (their usage policy), e.g. with a way to reach you.
UOV_USER_AGENT=clawback/1.0 (+https://github.com/<you>/clawback)
# 1 = upload the files gzipped. Only needed when Cloudflare doesn't compress them (see README).
UPLOAD_GZIP=0
# Folder on the HDDs for the downloaded feed (~165 MB) and the current data (~5 MB).
CLAWBACK_DATA=/path/to/clawback
# User and group that should own the files there (check with: id yourname).
PUID=1000
PGID=1000
